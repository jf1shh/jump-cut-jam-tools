/work/audio/

# fal music: ledger lock file and atomic-rewrite temp files (gen_music_fal.py); the ledger CSV itself IS tracked.
/stages/02_build/output/*.lock
/stages/02_build/output/*.tmp

# Python bytecode caches.
__pycache__/
