# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Asset-pipeline test output (gen_asset.py) — throwaway/regenerable, not real
# jam art. Keep only stages/02_build/output/asset-pipeline-log.csv tracked for timing history.
/work/generated/

# Audio-pipeline test output (gen_music.py) — same deal, keep only
